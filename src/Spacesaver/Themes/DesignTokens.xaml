<?xml version="1.0" encoding="utf-8"?>

<ResourceDictionary

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">



    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">

            <SolidColorBrush x:Key="SemanticGoodBrush" Color="#2E7D32" />

            <SolidColorBrush x:Key="SemanticImportantBrush" Color="#E65100" />

            <SolidColorBrush x:Key="SemanticAttentionBrush" Color="#F57F17" />

            <SolidColorBrush x:Key="SemanticInformativeBrush" Color="#1565C0" />



            <SolidColorBrush x:Key="SemanticGoodTintBrush" Color="#1A2E7D32" />

            <SolidColorBrush x:Key="SemanticImportantTintBrush" Color="#1AE65100" />

            <SolidColorBrush x:Key="SemanticAttentionTintBrush" Color="#1AF57F17" />

            <SolidColorBrush x:Key="SemanticInformativeTintBrush" Color="#1A1565C0" />



            <SolidColorBrush x:Key="CardElevatedBorderBrush" Color="#0D000000" />

        </ResourceDictionary>



        <ResourceDictionary x:Key="Dark">

            <SolidColorBrush x:Key="SemanticGoodBrush" Color="#66BB6A" />

            <SolidColorBrush x:Key="SemanticImportantBrush" Color="#FFA726" />

            <SolidColorBrush x:Key="SemanticAttentionBrush" Color="#FFD54F" />

            <SolidColorBrush x:Key="SemanticInformativeBrush" Color="#64B5F6" />



            <SolidColorBrush x:Key="SemanticGoodTintBrush" Color="#1A66BB6A" />

            <SolidColorBrush x:Key="SemanticImportantTintBrush" Color="#1AFFA726" />

            <SolidColorBrush x:Key="SemanticAttentionTintBrush" Color="#1AFFD54F" />

            <SolidColorBrush x:Key="SemanticInformativeTintBrush" Color="#1A64B5F6" />



            <SolidColorBrush x:Key="CardElevatedBorderBrush" Color="#33FFFFFF" />

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>



    <Thickness x:Key="PagePadding">32,24,32,32</Thickness>
    <Thickness x:Key="CardPadding">24</Thickness>
    <Thickness x:Key="SettingsCardPadding">16</Thickness>

    <x:Double x:Key="ContentMaxWidth">960</x:Double>

    <x:Double x:Key="LayoutBreakpointNarrow">520</x:Double>



    <x:Double x:Key="SpacingXS">4</x:Double>

    <x:Double x:Key="SpacingS">8</x:Double>

    <x:Double x:Key="SpacingM">12</x:Double>

    <x:Double x:Key="SpacingL">16</x:Double>

    <x:Double x:Key="SpacingXL">24</x:Double>

    <x:Double x:Key="SpacingXXL">32</x:Double>



    <CornerRadius x:Key="CornerRadiusCard">12</CornerRadius>

    <CornerRadius x:Key="CornerRadiusControl">8</CornerRadius>

    <CornerRadius x:Key="CornerRadiusChip">4</CornerRadius>



    <x:Double x:Key="FontSizeTitle">28</x:Double>

    <x:Double x:Key="FontSizeSection">20</x:Double>

    <x:Double x:Key="FontSizeBody">14</x:Double>

    <x:Double x:Key="FontSizeCaption">12</x:Double>

    <x:Double x:Key="FontSizeDetail">13</x:Double>



    <Style x:Key="PageTitleTextBlockStyle" TargetType="TextBlock">

        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />

        <Setter Property="FontWeight" Value="SemiBold" />

        <Setter Property="TextWrapping" Value="WrapWholeWords" />

    </Style>



    <Style x:Key="PageSubtitleTextBlockStyle" TargetType="TextBlock">

        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />

        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />

        <Setter Property="TextWrapping" Value="WrapWholeWords" />

    </Style>



    <Style x:Key="SectionHeaderTextBlockStyle" TargetType="TextBlock">

        <Setter Property="FontSize" Value="{StaticResource FontSizeSection}" />

        <Setter Property="FontWeight" Value="SemiBold" />

    </Style>



    <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock">

        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />

        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />

        <Setter Property="TextWrapping" Value="WrapWholeWords" />

    </Style>



    <Style x:Key="DetailTextBlockStyle" TargetType="TextBlock">

        <Setter Property="FontSize" Value="{StaticResource FontSizeDetail}" />

        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />

        <Setter Property="TextWrapping" Value="WrapWholeWords" />

    </Style>



    <Style x:Key="CardBorderStyle" TargetType="Border">

        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />

        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />

        <Setter Property="BorderThickness" Value="1" />

        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusCard}" />

        <Setter Property="Padding" Value="{StaticResource CardPadding}" />

    </Style>



    <Style x:Key="SemanticChipBorderStyle" TargetType="Border">

        <Setter Property="Padding" Value="8,2" />

        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusChip}" />

        <Setter Property="BorderThickness" Value="1" />

    </Style>



    <Style x:Key="CategoryTileButtonStyle" TargetType="Button">

        <Setter Property="HorizontalAlignment" Value="Stretch" />

        <Setter Property="HorizontalContentAlignment" Value="Left" />

        <Setter Property="VerticalContentAlignment" Value="Top" />

        <Setter Property="Padding" Value="16" />

        <Setter Property="MinHeight" Value="96" />

        <Setter Property="CornerRadius" Value="{StaticResource CornerRadiusControl}" />

        <Setter Property="BorderThickness" Value="1" />

    </Style>



    <Style x:Key="SubtleButtonStyle" TargetType="Button">

        <Setter Property="HorizontalAlignment" Value="Left" />

        <Setter Property="Background" Value="Transparent" />

        <Setter Property="BorderThickness" Value="0" />

        <Setter Property="Padding" Value="0,4" />

        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />

        <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />

    </Style>



    <Style x:Key="DestructiveButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">

        <Setter Property="BorderBrush" Value="{ThemeResource SemanticAttentionBrush}" />

        <Setter Property="Background" Value="{ThemeResource SemanticAttentionTintBrush}" />

        <Setter Property="Foreground" Value="{ThemeResource SemanticAttentionBrush}" />

    </Style>



    <Style x:Key="TransparentListViewItemStyle" TargetType="ListViewItem">

        <Setter Property="Padding" Value="0" />

        <Setter Property="Margin" Value="0,0,0,8" />

        <Setter Property="HorizontalContentAlignment" Value="Stretch" />

        <Setter Property="Background" Value="Transparent" />

        <Setter Property="BorderThickness" Value="0" />

    </Style>



    <Style x:Key="SettingsCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">

        <Setter Property="Padding" Value="{StaticResource SettingsCardPadding}" />

    </Style>



</ResourceDictionary>


