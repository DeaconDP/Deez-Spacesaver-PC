<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Cyberpunk-dark tokens (restrained; teal primary, pink secondary) -->
    <Color x:Key="AppBgColor">#0A0B0F</Color>
    <Color x:Key="AppSurfaceColor">#12141C</Color>
    <Color x:Key="AppTextColor">#E8EAEF</Color>
    <Color x:Key="AppMutedColor">#8B90A0</Color>
    <Color x:Key="AppAccentColor">#00E5C0</Color>
    <Color x:Key="AppAccent2Color">#FF3D81</Color>
    <Color x:Key="AppBorderColor">#2A2E3A</Color>

    <SolidColorBrush x:Key="AppBgBrush" Color="{StaticResource AppBgColor}" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurfaceColor}" />
    <SolidColorBrush x:Key="AppTextBrush" Color="{StaticResource AppTextColor}" />
    <SolidColorBrush x:Key="AppMutedBrush" Color="{StaticResource AppMutedColor}" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="{StaticResource AppAccentColor}" />
    <SolidColorBrush x:Key="AppAccent2Brush" Color="{StaticResource AppAccent2Color}" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="{StaticResource AppBorderColor}" />

    <SolidColorBrush x:Key="SemanticGoodBrush" Color="#00E5C0" />
    <SolidColorBrush x:Key="SemanticImportantBrush" Color="#FF8A4C" />
    <SolidColorBrush x:Key="SemanticAttentionBrush" Color="#FF3D81" />
    <SolidColorBrush x:Key="SemanticInformativeBrush" Color="#6B9EFF" />

    <SolidColorBrush x:Key="SemanticGoodTintBrush" Color="#1A00E5C0" />
    <SolidColorBrush x:Key="SemanticImportantTintBrush" Color="#1AFF8A4C" />
    <SolidColorBrush x:Key="SemanticAttentionTintBrush" Color="#1AFF3D81" />
    <SolidColorBrush x:Key="SemanticInformativeTintBrush" Color="#1A6B9EFF" />

    <x:Double x:Key="PageContentMaxWidth">960</x:Double>
    <Thickness x:Key="PagePaddingNarrow">16,16,16,24</Thickness>
    <Thickness x:Key="PagePaddingWide">32,24,32,32</Thickness>
    <CornerRadius x:Key="AppCornerRadius">2</CornerRadius>
    <CornerRadius x:Key="AppCornerRadiusSm">2</CornerRadius>
    <CornerRadius x:Key="AppCornerRadiusMd">4</CornerRadius>

    <TransitionCollection x:Key="StaggeredEntranceTransitions">
        <EntranceThemeTransition FromVerticalOffset="10" IsStaggeringEnabled="True" />
        <RepositionThemeTransition IsStaggeringEnabled="True" />
    </TransitionCollection>

    <!-- Type styles -->
    <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style x:Key="TitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource AppTextBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource AppMutedBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
        <Setter Property="LineHeight" Value="22" />
    </Style>

    <Style x:Key="MetaTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource AppMutedBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>

    <Style x:Key="PageRootStyle" TargetType="Grid">
        <Setter Property="MaxWidth" Value="{StaticResource PageContentMaxWidth}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="{StaticResource PagePaddingWide}" />
    </Style>

    <Style x:Key="SurfaceBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadiusMd}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="MetaChipBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadiusSm}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CategoryTileButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="MinHeight" Value="88" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadiusMd}" />
    </Style>

    <Style x:Key="PrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="20,8" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadiusSm}" />
    </Style>

    <Style x:Key="SecondaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadiusSm}" />
    </Style>

    <Style x:Key="ApplyFooterBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadiusMd}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="RecommendationRowBorderStyle" TargetType="Border">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AppCornerRadiusMd}" />
    </Style>
</ResourceDictionary>
