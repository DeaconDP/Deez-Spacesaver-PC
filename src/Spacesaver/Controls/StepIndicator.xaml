<?xml version="1.0" encoding="utf-8"?>

<UserControl

    x:Class="Spacesaver.Controls.StepIndicator"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    mc:Ignorable="d">

    <StackPanel Spacing="{StaticResource SpacingM}">

        <ProgressBar

            x:Name="StepProgress"

            Maximum="3"

            Value="{x:Bind CurrentStep, Mode=OneWay}" />

        <Grid ColumnSpacing="{StaticResource SpacingS}">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*" />

                <ColumnDefinition Width="*" />

                <ColumnDefinition Width="*" />

                <ColumnDefinition Width="*" />

            </Grid.ColumnDefinitions>



            <TextBlock

                x:Name="Step0Label"

                Grid.Column="0"

                HorizontalAlignment="Center"

                FontSize="{StaticResource FontSizeCaption}"

                Text="Scan" />

            <TextBlock

                x:Name="Step1Label"

                Grid.Column="1"

                HorizontalAlignment="Center"

                FontSize="{StaticResource FontSizeCaption}"

                Text="Review" />

            <TextBlock

                x:Name="Step2Label"

                Grid.Column="2"

                HorizontalAlignment="Center"

                FontSize="{StaticResource FontSizeCaption}"

                Text="Confirm" />

            <TextBlock

                x:Name="Step3Label"

                Grid.Column="3"

                HorizontalAlignment="Center"

                FontSize="{StaticResource FontSizeCaption}"

                Text="Results" />

        </Grid>

    </StackPanel>

</UserControl>


