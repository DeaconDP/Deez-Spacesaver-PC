<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Spacesaver.Controls.CategoryTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Button
        x:Name="TileButton"
        Click="TileButton_Click"
        Style="{StaticResource CategoryTileButtonStyle}">
        <StackPanel Spacing="{StaticResource SpacingXS}">
            <FontIcon
                x:Name="IconElement"
                FontSize="{StaticResource FontSizeSection}" />
            <TextBlock
                FontWeight="SemiBold"
                Text="{x:Bind Title, Mode=OneWay}" />
            <TextBlock
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Caption, Mode=OneWay}" />
        </StackPanel>
    </Button>
</UserControl>
