<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Spacesaver.Controls.SemanticChip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Border
        Style="{StaticResource SemanticChipBorderStyle}"
        Background="{x:Bind TintBrush, Mode=OneWay}"
        BorderBrush="{x:Bind AccentBrush, Mode=OneWay}">
        <TextBlock
            FontSize="{StaticResource FontSizeCaption}"
            FontWeight="SemiBold"
            Foreground="{x:Bind AccentBrush, Mode=OneWay}"
            Text="{x:Bind Label, Mode=OneWay}" />
    </Border>
</UserControl>
