<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Spacesaver.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <StackPanel Spacing="{StaticResource SpacingS}">
        <TextBlock
            x:Name="TitleBlock"
            Style="{StaticResource PageTitleTextBlockStyle}"
            Text="{x:Bind Title, Mode=OneWay}" />
        <TextBlock
            x:Name="SubtitleBlock"
            Style="{StaticResource PageSubtitleTextBlockStyle}"
            Text="{x:Bind Subtitle, Mode=OneWay}"
            Visibility="{x:Bind SubtitleVisibility, Mode=OneWay}" />
        <ProgressBar
            x:Name="UsageBar"
            Maximum="100"
            Visibility="{x:Bind ProgressVisibility, Mode=OneWay}"
            Value="{x:Bind ProgressValue, Mode=OneWay}" />
    </StackPanel>
</UserControl>
