<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Spacesaver.Pages.TaskListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowSizeStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageRoot.Padding" Value="{StaticResource PagePaddingWide}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageRoot.Padding" Value="{StaticResource PagePaddingNarrow}" />
                        <Setter Target="HeaderText.FontSize" Value="24" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid
            x:Name="PageRoot"
            MaxWidth="{StaticResource PageContentMaxWidth}"
            HorizontalAlignment="Stretch"
            Padding="{StaticResource PagePaddingWide}"
            RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock
                    x:Name="HeaderText"
                    Style="{StaticResource TitleTextStyle}"
                    Text="All Tasks" />
                <TextBlock
                    x:Name="SubtitleText"
                    Style="{StaticResource BodyTextStyle}"
                    Text="Select a task to see step-by-step guidance." />
            </StackPanel>

            <ListView
                x:Name="TaskListView"
                Grid.Row="1"
                ItemContainerTransitions="{StaticResource StaggeredEntranceTransitions}"
                IsItemClickEnabled="True"
                ItemClick="TaskListView_ItemClick"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,12" ColumnSpacing="12" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <FontIcon
                                Grid.RowSpan="2"
                                VerticalAlignment="Top"
                                Margin="0,2,0,0"
                                FontSize="18"
                                Foreground="{Binding RiskBrush}"
                                Glyph="{Binding Task.IconGlyph}" />

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{Binding Task.Title}"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    Foreground="{StaticResource AppMutedBrush}"
                                    Text="{Binding Subtitle}"
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>

                            <FontIcon
                                Grid.Column="2"
                                VerticalAlignment="Top"
                                Margin="0,4,0,0"
                                FontSize="16"
                                Foreground="{StaticResource SemanticGoodBrush}"
                                Glyph="&#xE73E;"
                                Visibility="{Binding DoneIconVisibility}" />

                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                Padding="8,2"
                                Background="{Binding RiskTintBrush}"
                                BorderBrush="{Binding RiskBrush}"
                                BorderThickness="1"
                                CornerRadius="2">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding RiskBrush}"
                                    Text="{Binding Task.RiskLabel}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
