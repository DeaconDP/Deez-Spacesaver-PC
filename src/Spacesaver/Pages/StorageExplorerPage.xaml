<?xml version="1.0" encoding="utf-8" ?>

<Page

    x:Class="Spacesaver.Pages.StorageExplorerPage"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:controls="using:Spacesaver.Controls"

    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    mc:Ignorable="d">



    <controls:PageLayout>

        <Grid RowSpacing="{StaticResource SpacingL}">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto" />

                <RowDefinition Height="Auto" />

                <RowDefinition Height="Auto" />

                <RowDefinition Height="Auto" />

                <RowDefinition Height="*" />

            </Grid.RowDefinitions>



            <controls:PageHeader

                x:Name="PageHeaderControl"

                ShowProgressBar="True"

                Subtitle="Scanning your drive…"

                Title="Storage" />



            <Expander

                Grid.Row="1"

                Header="Folders only"

                IsExpanded="False">

                <TextBlock

                    Margin="0,8,0,0"

                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"

                    Text="Analyze only — nothing is deleted or moved. Some system folders may show partial sizes without administrator access. Open folders in Explorer to review and free space manually."

                    TextWrapping="WrapWholeWords" />

            </Expander>



            <BreadcrumbBar

                x:Name="FolderBreadcrumb"

                Grid.Row="2"

                ItemClicked="FolderBreadcrumb_ItemClicked" />



            <controls:ScanStatusRow

                x:Name="ScanStatus"

                Grid.Row="3" />



            <ListView

                x:Name="FolderList"

                Grid.Row="4"

                IsItemClickEnabled="False"

                ItemContainerStyle="{StaticResource TransparentListViewItemStyle}"

                ItemContainerTransitions="{StaticResource StaggeredEntranceTransitions}"

                SelectionMode="None">

                <ListView.ItemTemplate>

                    <DataTemplate>

                        <controls:ListCard

                            AccentBrush="{Binding ImportanceBrush}"

                            TintBrush="{Binding ImportanceTintBrush}">

                            <Grid ColumnSpacing="{StaticResource SpacingM}">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />

                                </Grid.ColumnDefinitions>



                                <StackPanel Spacing="{StaticResource SpacingS}">

                                    <Grid ColumnSpacing="{StaticResource SpacingS}">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>



                                        <TextBlock

                                            FontSize="{StaticResource FontSizeBody}"

                                            FontWeight="SemiBold"

                                            Text="{Binding Name}"

                                            TextWrapping="WrapWholeWords" />



                                        <TextBlock

                                            Grid.Column="1"

                                            VerticalAlignment="Center"

                                            FontWeight="SemiBold"

                                            Foreground="{Binding ImportanceBrush}"

                                            Text="{Binding FormattedSize}" />

                                    </Grid>



                                    <TextBlock

                                        Style="{StaticResource CaptionTextBlockStyle}"

                                        Text="{Binding Path}" />



                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingS}">

                                        <controls:SemanticChip

                                            AccentBrush="{Binding ImportanceBrush}"

                                            Label="{Binding ImportanceLabel}"

                                            TintBrush="{Binding ImportanceTintBrush}" />

                                        <TextBlock

                                            VerticalAlignment="Center"

                                            Style="{StaticResource CaptionTextBlockStyle}"

                                            Text="{Binding PercentLabel}" />

                                        <TextBlock

                                            VerticalAlignment="Center"

                                            Style="{StaticResource CaptionTextBlockStyle}"

                                            Text="{Binding ChildFolderLabel}" />

                                    </StackPanel>



                                    <TextBlock

                                        Style="{StaticResource DetailTextBlockStyle}"

                                        Text="{Binding ClassificationReason}" />



                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingM}">

                                        <Button

                                            Click="OpenInExplorer_Click"

                                            Content="Open in Explorer"

                                            Tag="{Binding Path}" />

                                        <Button

                                            Click="DrillDown_Click"

                                            Content="Open folder"

                                            Tag="{Binding Path}"

                                            Visibility="{Binding DrillDownVisibility}" />

                                        <HyperlinkButton

                                            Click="RelatedTask_Click"

                                            Content="Related cleanup task"

                                            Tag="{Binding RelatedTaskId}"

                                            Visibility="{Binding RelatedTaskVisibility}" />

                                    </StackPanel>

                                </StackPanel>

                            </Grid>

                        </controls:ListCard>

                    </DataTemplate>

                </ListView.ItemTemplate>

            </ListView>

        </Grid>

    </controls:PageLayout>

</Page>


