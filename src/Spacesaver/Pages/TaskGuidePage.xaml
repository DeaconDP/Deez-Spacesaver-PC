<?xml version="1.0" encoding="utf-8" ?>

<Page

    x:Class="Spacesaver.Pages.TaskGuidePage"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:controls="using:Spacesaver.Controls"

    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    mc:Ignorable="d">



    <controls:PageLayout>

        <Grid RowSpacing="{StaticResource SpacingL}">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto" />

                <RowDefinition Height="Auto" />

                <RowDefinition Height="*" />

            </Grid.RowDefinitions>



            <controls:PageHeader

                x:Name="PageHeaderControl"

                Subtitle="Select a task to see step-by-step guidance."

                Title="Tasks" />



            <TabView

                x:Name="CategoryTabs"

                Grid.Row="1"

                AddTabButtonClick="CategoryTabs_AddTabButtonClick"

                CanDragTabs="False"

                CanReorderTabs="False"

                IsAddTabButtonVisible="False"

                TabCloseRequested="CategoryTabs_TabCloseRequested"

                SelectionChanged="CategoryTabs_SelectionChanged">

                <TabViewItem Header="All" Tag="all" />

                <TabViewItem Header="Quick Wins" Tag="QuickWins" />

                <TabViewItem Header="System" Tag="SystemCleanup" />

                <TabViewItem Header="Large Wins" Tag="LargeSpaceWins" />

                <TabViewItem Header="Manual" Tag="ManualReview" />

            </TabView>



            <ListView

                x:Name="TaskListView"

                Grid.Row="2"

                IsItemClickEnabled="True"

                ItemClick="TaskListView_ItemClick"

                ItemContainerStyle="{StaticResource TransparentListViewItemStyle}"

                ItemContainerTransitions="{StaticResource StaggeredEntranceTransitions}"

                SelectionMode="None">

                <ListView.ItemTemplate>

                    <DataTemplate>

                        <controls:ListCard

                            AccentBrush="{Binding RiskBrush}"

                            TintBrush="{Binding RiskTintBrush}">

                            <Grid ColumnSpacing="{StaticResource SpacingL}">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto" />

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />

                                    <ColumnDefinition Width="Auto" />

                                    <ColumnDefinition Width="Auto" />

                                </Grid.ColumnDefinitions>



                                <FontIcon

                                    VerticalAlignment="Center"

                                    FontSize="18"

                                    Foreground="{Binding RiskBrush}"

                                    Glyph="{Binding Task.IconGlyph}" />



                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">

                                    <TextBlock

                                        FontSize="{StaticResource FontSizeBody}"

                                        FontWeight="SemiBold"

                                        Text="{Binding Task.Title}" />

                                    <TextBlock

                                        Style="{StaticResource CaptionTextBlockStyle}"

                                        Text="{Binding Subtitle}" />

                                </StackPanel>



                                <controls:SemanticChip

                                    Grid.Column="2"

                                    VerticalAlignment="Center"

                                    AccentBrush="{Binding RiskBrush}"

                                    Label="{Binding Task.RiskLabel}"

                                    TintBrush="{Binding RiskTintBrush}" />



                                <FontIcon

                                    Grid.Column="3"

                                    VerticalAlignment="Center"

                                    FontSize="{StaticResource FontSizeBody}"

                                    Foreground="{ThemeResource SemanticGoodBrush}"

                                    Glyph="&#xE73E;"

                                    Visibility="{Binding DoneIconVisibility}" />



                                <FontIcon

                                    Grid.Column="4"

                                    VerticalAlignment="Center"

                                    FontSize="{StaticResource FontSizeBody}"

                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"

                                    Glyph="&#xE76C;" />

                            </Grid>

                        </controls:ListCard>

                    </DataTemplate>

                </ListView.ItemTemplate>

            </ListView>

        </Grid>

    </controls:PageLayout>

</Page>


