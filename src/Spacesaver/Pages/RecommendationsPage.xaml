<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Spacesaver.Pages.RecommendationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        x:Name="PageRoot"
        MaxWidth="{StaticResource PageContentMaxWidth}"
        HorizontalAlignment="Stretch"
        Padding="{StaticResource PagePaddingWide}"
        RowSpacing="16"
        SizeChanged="PageRoot_SizeChanged">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowSizeStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageRoot.Padding" Value="{StaticResource PagePaddingWide}" />
                        <Setter Target="LegendInfoBar.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageRoot.Padding" Value="{StaticResource PagePaddingNarrow}" />
                        <Setter Target="LegendInfoBar.Visibility" Value="Collapsed" />
                        <Setter Target="HeaderTitle.FontSize" Value="24" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="HeaderPanel" Spacing="8">
            <TextBlock
                x:Name="HeaderTitle"
                Style="{StaticResource TitleTextStyle}"
                Text="Recommendations" />
            <TextBlock
                x:Name="DriveSummaryText"
                Style="{StaticResource BodyTextStyle}"
                Text="Scanning your drive…" />
            <ProgressBar
                x:Name="DriveUsageBar"
                Maximum="100"
                Value="0" />
        </StackPanel>

        <InfoBar
            x:Name="LegendInfoBar"
            Grid.Row="1"
            IsClosable="False"
            IsOpen="True"
            Message="Teal = safe and high value. Orange = important. Pink = needs attention. Blue = optional. Safe deletions run here; other actions open Windows tools."
            Severity="Informational"
            Title="How to read this list" />

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ProgressRing
                x:Name="ScanProgressRing"
                Width="28"
                Height="28"
                IsActive="True" />

            <TextBlock
                x:Name="ScanStatusText"
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource BodyTextStyle}"
                Text="Starting scan…" />

            <Button
                x:Name="RescanButton"
                Grid.Column="2"
                Click="RescanButton_Click"
                Content="Scan again"
                Style="{StaticResource SecondaryActionButtonStyle}"
                Visibility="Collapsed" />
        </Grid>

        <ListView
            x:Name="RecommendationsList"
            Grid.Row="3"
            ItemContainerTransitions="{StaticResource StaggeredEntranceTransitions}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,0,0,8"
                        Background="{Binding ImpactTintBrush}"
                        BorderBrush="{StaticResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid>
                            <Border
                                Width="3"
                                HorizontalAlignment="Left"
                                Background="{Binding ImpactBrush}"
                                CornerRadius="2,0,0,2" />

                            <Grid Padding="16,12,16,12" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <CheckBox
                                    VerticalAlignment="Top"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="{Binding Title}"
                                        TextWrapping="WrapWholeWords" />

                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{Binding ImpactBrush}"
                                        Text="{Binding FormattedSize}"
                                        Visibility="{Binding SizeVisibility}" />

                                    <TextBlock
                                        Foreground="{StaticResource AppMutedBrush}"
                                        Text="{Binding ScanDetail}"
                                        TextWrapping="WrapWholeWords" />

                                    <StackPanel Orientation="Vertical" Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border
                                                Padding="8,2"
                                                Background="{Binding ImpactBrush}"
                                                CornerRadius="2">
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="#0A0B0F"
                                                    Text="{Binding ImpactLabel}" />
                                            </Border>
                                            <Border
                                                Padding="8,2"
                                                Background="{Binding RiskBrush}"
                                                CornerRadius="2">
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="#0A0B0F"
                                                    Text="{Binding RiskLabel}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding ExecutionForeground}"
                                            Text="{Binding ExecutionLabel}"
                                            TextWrapping="WrapWholeWords" />
                                    </StackPanel>

                                    <TextBlock
                                        FontSize="13"
                                        Text="{Binding RiskSummary}"
                                        TextWrapping="WrapWholeWords" />

                                    <HyperlinkButton
                                        Click="LearnMore_Click"
                                        Content="Learn more"
                                        Padding="0"
                                        Tag="{Binding TaskId}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border
            x:Name="ApplyFooter"
            Grid.Row="4"
            Style="{StaticResource ApplyFooterBorderStyle}">
            <Grid x:Name="FooterGrid" ColumnSpacing="16" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock
                        x:Name="SelectionSummaryText"
                        FontWeight="SemiBold"
                        Text="0 selected"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        x:Name="ApplyStatusText"
                        Style="{StaticResource BodyTextStyle}"
                        Visibility="Collapsed" />
                </StackPanel>

                <Button
                    x:Name="ApplyButton"
                    Grid.Column="1"
                    MinWidth="140"
                    VerticalAlignment="Center"
                    Click="ApplyButton_Click"
                    Content="Apply Selected"
                    IsEnabled="False"
                    Style="{StaticResource PrimaryActionButtonStyle}" />
            </Grid>
        </Border>
    </Grid>
</Page>
