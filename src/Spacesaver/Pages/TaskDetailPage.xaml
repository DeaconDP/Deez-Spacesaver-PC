<?xml version="1.0" encoding="utf-8" ?>

<Page

    x:Class="Spacesaver.Pages.TaskDetailPage"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:controls="using:Spacesaver.Controls"

    xmlns:viewModels="using:Spacesaver.ViewModels"

    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    mc:Ignorable="d">



    <controls:PageLayout>

        <ScrollViewer>

            <StackPanel Spacing="{StaticResource SpacingXL}">

                <controls:PageHeader

                    x:Name="PageHeaderControl"

                    Subtitle="Description"

                    Title="Task title" />



                <TextBlock

                    x:Name="TaskNumberText"

                    Style="{StaticResource CaptionTextBlockStyle}"

                    Text="Task #1" />



                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingM}">

                    <controls:SemanticChip

                        x:Name="SavingsChip"

                        Label="1–5 GB" />

                    <controls:SemanticChip

                        x:Name="RiskChip"

                        Label="Safe" />

                    <controls:SemanticChip

                        x:Name="CategoryChip"

                        Label="Quick Wins" />

                </StackPanel>



                <InfoBar

                    x:Name="AdminInfoBar"

                    IsClosable="False"

                    IsOpen="False"

                    Message="This step requires Administrator privileges. Run the opened tool as admin when prompted."

                    Severity="Warning"

                    Title="Administrator required" />



                <InfoBar

                    x:Name="WarningInfoBar"

                    IsClosable="False"

                    IsOpen="False"

                    Severity="Error"

                    Title="Read before proceeding" />



                <Border Style="{StaticResource CardBorderStyle}">

                    <StackPanel Spacing="{StaticResource SpacingM}">

                        <TextBlock Style="{StaticResource SectionHeaderTextBlockStyle}" Text="Steps" />

                        <ItemsControl x:Name="StepsList">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate x:DataType="viewModels:StepRowViewModel">

                                    <controls:StepRow

                                        StepNumber="{x:Bind StepNumber}"

                                        StepText="{x:Bind StepText}"

                                        Tone="{x:Bind Tone}" />

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </Border>



                <Grid ColumnSpacing="{StaticResource SpacingM}">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*" />

                        <ColumnDefinition Width="Auto" />

                        <ColumnDefinition Width="Auto" />

                    </Grid.ColumnDefinitions>



                    <Button

                        x:Name="CopyCommandButton"

                        Grid.Column="1"

                        Click="CopyCommandButton_Click"

                        Content="Copy Command"

                        Visibility="Collapsed" />

                    <Button

                        x:Name="OpenToolButton"

                        Grid.Column="2"

                        Click="OpenToolButton_Click"

                        Content="Open Tool"

                        Style="{StaticResource AccentButtonStyle}" />

                </Grid>



                <Border Style="{StaticResource CardBorderStyle}">

                    <StackPanel Spacing="{StaticResource SpacingS}">

                        <TextBlock

                            Style="{StaticResource PageSubtitleTextBlockStyle}"

                            Text="Track your progress as you complete this task." />

                        <ToggleSwitch

                            x:Name="DoneToggle"

                            AutomationProperties.Name="Mark task as done"

                            OffContent="Mark as not done"

                            OnContent="Marked as done"

                            Toggled="DoneToggle_Toggled" />

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </controls:PageLayout>

</Page>


