<?xml version="1.0" encoding="utf-8" ?>

<Page

    x:Class="Spacesaver.Pages.SettingsPage"

    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    xmlns:controls="using:Spacesaver.Controls"

    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

    mc:Ignorable="d">



    <controls:PageLayout>

        <ScrollViewer>

            <StackPanel Spacing="{StaticResource SpacingXL}">

                <controls:PageHeader

                    x:Name="PageHeaderControl"

                    Subtitle="Appearance, progress, and safety preferences."

                    Title="Settings" />



                <Border Style="{StaticResource SettingsCardStyle}">

                    <StackPanel Spacing="{StaticResource SpacingL}">

                        <TextBlock

                            FontSize="{StaticResource FontSizeBody}"

                            FontWeight="SemiBold"

                            Text="Appearance" />

                        <TextBlock

                            Style="{StaticResource CaptionTextBlockStyle}"

                            Text="Theme" />

                        <RadioButtons x:Name="ThemeRadioButtons" SelectionChanged="ThemeRadioButtons_SelectionChanged">

                            <RadioButton Content="System default" Tag="Default" />

                            <RadioButton Content="Light" Tag="Light" />

                            <RadioButton Content="Dark" Tag="Dark" />

                        </RadioButtons>

                    </StackPanel>

                </Border>



                <Border x:Name="ProgressCard" Style="{StaticResource SettingsCardStyle}">

                    <StackPanel Spacing="{StaticResource SpacingL}">

                        <TextBlock

                            FontSize="{StaticResource FontSizeBody}"

                            FontWeight="SemiBold"

                            Text="Progress" />

                        <TextBlock

                            x:Name="ProgressSummaryText"

                            Style="{StaticResource PageSubtitleTextBlockStyle}"

                            Text="0 of 20 tasks marked complete" />

                        <Button

                            Click="ResetProgress_Click"

                            Content="Reset all progress"

                            Style="{StaticResource DestructiveButtonStyle}" />

                    </StackPanel>

                </Border>



                <Border Style="{StaticResource SettingsCardStyle}">

                    <StackPanel Spacing="{StaticResource SpacingL}">

                        <TextBlock

                            FontSize="{StaticResource FontSizeBody}"

                            FontWeight="SemiBold"

                            Text="Safety" />

                        <ToggleSwitch

                            x:Name="SafetyInfoToggle"

                            OffContent="Safety message hidden on dashboard"

                            OnContent="Show safety message on dashboard"

                            Toggled="SafetyInfoToggle_Toggled" />

                        <Button

                            Click="ReplayOnboarding_Click"

                            Content="Show welcome screen again"

                            Style="{StaticResource SubtleButtonStyle}" />

                    </StackPanel>

                </Border>



                <Border x:Name="SafetyCard" Style="{StaticResource SettingsCardStyle}">

                    <StackPanel Spacing="{StaticResource SpacingM}">

                        <TextBlock

                            FontSize="{StaticResource FontSizeBody}"

                            FontWeight="SemiBold"

                            Text="What this app does not recommend" />

                        <TextBlock

                            Style="{StaticResource PageSubtitleTextBlockStyle}"

                            LineHeight="22"

                            Text="• Third-party registry cleaners or &quot;PC optimizer&quot; tools&#x0a;• Manually deleting C:\Windows\WinSxS&#x0a;• Deleting C:\Windows\Prefetch&#x0a;• Bulk-deleting Downloads without reviewing contents" />

                    </StackPanel>

                </Border>



                <TextBlock

                    Style="{StaticResource CaptionTextBlockStyle}"

                    Text="PC Spacesaver v1.0 · Guided cleanup using built-in Windows tools" />

            </StackPanel>

        </ScrollViewer>

    </controls:PageLayout>

</Page>


