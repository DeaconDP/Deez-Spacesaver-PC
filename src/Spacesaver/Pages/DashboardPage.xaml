<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Spacesaver.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Spacesaver.Controls"
    xmlns:models="using:Spacesaver.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Disabled"
    mc:Ignorable="d">

    <Grid x:Name="LayoutRoot">
        <controls:PageLayout>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="{StaticResource SpacingXL}">
                    <controls:PageHeader
                        x:Name="PageHeaderControl"
                        ShowProgressBar="True"
                        Subtitle="Loading drive information…"
                        Title="Dashboard" />

                    <Grid
                        x:Name="HeroGrid"
                        MinHeight="140"
                        ColumnSpacing="{StaticResource SpacingM}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <controls:StatCard
                            x:Name="CtaCard"
                            Grid.Column="0">
                            <StackPanel Spacing="{StaticResource SpacingM}">
                                <TextBlock
                                    FontSize="{StaticResource FontSizeSection}"
                                    FontWeight="SemiBold"
                                    Text="Analyze and clean" />
                                <TextBlock
                                    Style="{StaticResource PageSubtitleTextBlockStyle}"
                                    Text="Scan your drive for tailored recommendations, then choose what to apply safely." />
                                <Button
                                    x:Name="AnalyzeButton"
                                    HorizontalAlignment="Stretch"
                                    Click="AnalyzeAndClean_Click"
                                    Content="Start cleanup wizard"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </controls:StatCard>

                        <controls:StatCard
                            x:Name="ProgressCard"
                            Grid.Column="1">
                            <StackPanel HorizontalAlignment="Stretch" Spacing="{StaticResource SpacingM}">
                                <ProgressRing
                                    x:Name="ProgressRing"
                                    Width="64"
                                    Height="64"
                                    HorizontalAlignment="Center" />
                                <TextBlock
                                    x:Name="ProgressText"
                                    HorizontalAlignment="Center"
                                    FontSize="{StaticResource FontSizeSection}"
                                    FontWeight="SemiBold"
                                    Text="0 of 20 complete" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource PageSubtitleTextBlockStyle}"
                                    Text="Work through the checklist at your own pace."
                                    TextAlignment="Center" />
                                <Button
                                    x:Name="ViewTasksButton"
                                    HorizontalAlignment="Center"
                                    Click="ViewTasks_Click"
                                    Content="View all tasks"
                                    Style="{StaticResource SubtleButtonStyle}" />
                            </StackPanel>
                        </controls:StatCard>
                    </Grid>

                    <StackPanel x:Name="CategoriesPanel" Spacing="{StaticResource SpacingM}">
                        <TextBlock Style="{StaticResource SectionHeaderTextBlockStyle}" Text="Categories" />
                        <Grid
                            x:Name="CategoryGrid"
                            MinHeight="200"
                            ColumnSpacing="{StaticResource SpacingM}"
                            RowSpacing="{StaticResource SpacingM}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <controls:CategoryTile
                                x:Name="QuickWinsTile"
                                Grid.Row="0"
                                Grid.Column="0"
                                Caption="5 safe tasks · ~5 min"
                                Category="QuickWins"
                                Click="CategoryTile_Click"
                                IconGlyph="&#xE945;"
                                Title="Quick Wins" />
                            <controls:CategoryTile
                                x:Name="SystemCleanupTile"
                                Grid.Row="0"
                                Grid.Column="1"
                                Caption="5 admin tasks · ~10 min"
                                Category="SystemCleanup"
                                Click="CategoryTile_Click"
                                IconGlyph="&#xE7EF;"
                                Title="System Cleanup" />
                            <controls:CategoryTile
                                x:Name="LargeWinsTile"
                                Grid.Row="1"
                                Grid.Column="0"
                                Caption="5 caution tasks · read warnings"
                                Category="LargeSpaceWins"
                                Click="CategoryTile_Click"
                                IconGlyph="&#xE7FC;"
                                Title="Large Space Wins" />
                            <controls:CategoryTile
                                x:Name="ManualReviewTile"
                                Grid.Row="1"
                                Grid.Column="1"
                                Caption="5 tasks · your judgment"
                                Category="ManualReview"
                                Click="CategoryTile_Click"
                                IconGlyph="&#xE7B8;"
                                Title="Manual Review" />
                        </Grid>
                    </StackPanel>

                    <InfoBar
                        x:Name="SafetyInfoBar"
                        Closed="SafetyInfoBar_Closed"
                        IsClosable="True"
                        IsOpen="True"
                        Message="Safe actions (like emptying Recycle Bin and old Temp files) can run in this app after you confirm. Riskier actions open Windows tools — nothing is deleted without your approval."
                        Severity="Informational"
                        Title="Safe by design" />
                </StackPanel>
            </ScrollViewer>
        </controls:PageLayout>
    </Grid>
</Page>
